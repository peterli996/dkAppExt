{
	"main": "index.js",
	"scripts": {
		"clean": "rimraf ./build",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"prebuild": "npm run clean && npm run gen-locale && npm run check && npm run test",
		"build": "cross-env NODE_ENV=production THEME_PATH=./theme.json vite build",
		"postbuild": "node scripts/syncRes.js",
		"start": "cross-env THEME_PATH=./theme.json vite",
		"format": "prettier-eslint --list-different --write \"$(pwd)/src/**/*.{ts,tsx,js,jsx}\"",
		"lint": "eslint --ext ts,tsx,js,jsx src/",
		"gen-locale": "node -e \"require('@j2inn/fin5-ui-utils/dist/fantomProps/localePropsToJson').default('../locale/en.props','./src/localeKeys.json')\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@types/react": "^18.0.18",
		"@types/react-dom": "^18.0.6",
		"@typescript-eslint/eslint-plugin": "^5.36.2",
		"@typescript-eslint/parser": "^5.36.2",
		"@vitejs/plugin-react": "^4.3.4",
		"cross-env": "^7.0.3",
		"eslint": "^8.23.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-jest": "^27.6.3",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-react": "^7.33.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"less": "^4.1.1",
		"lint-staged": "^11.0.0",
		"prettier-eslint": "^16.3.0",
		"prettier-eslint-cli": "^8.0.1",
		"rimraf": "^3.0.2",
		"typedoc": "^0.23.15",
		"typescript": "^4.8.2",
		"vite": "^5.4.11",
		"vite-css-modules": "^1.7.0",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"@ant-design/icons": "^4.6.2",
		"@j2inn/fin5-ui-utils": "^3.0.1",
		"@j2inn/ui": "^7.0.5",
		"@j2inn/utils": "^6.0.0",
		"antd": "^6.3.5",
		"haystack-core": "^2.0.54",
		"haystack-nclient": "^3.0.41",
		"haystack-react": "^3.0.22",
		"haystack-units": "^1.0.27",
		"mobx": "^6.6.2",
		"mobx-react": "^7.5.3",
		"mobx-react-lite": "^3.4.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-jss": "^10.9.2",
		"react-router-dom": "^7.18.4"
	},
	"lint-staged": {
		"**/*.[jt]s(x)?": [
			"prettier-eslint --write",
			"eslint --fix"
		]
	}
}
