{
	"main": "index.js",
	"scripts": {
		"clean": "rimraf ./build",
		"check": "tsc --noEmit",
		"test": "jest --verbose --passWithNoTests ./test",
		"prebuild": "npm run clean && npm run gen-locale && npm run check && npm run test",
		"build": "cross-env NODE_ENV=production THEME_PATH=./theme.json webpack --config ./webpack.config.js",
		"start": "cross-env THEME_PATH=./theme.json webpack serve --config ./webpack.config.js --port 8081",
		"format": "prettier-eslint --list-different --write \"$(pwd)/src/**/*.{ts,tsx,js,jsx}\"",
		"lint": "eslint --ext ts,tsx,js,jsx src/",
		"gen-locale": "node -e \"require('@j2inn/fin5-ui-utils/dist/fantomProps/localePropsToJson').default('../locale/en.props','./src/localeKeys.json')\"",
		"analyze": "webpack --analyze --config node_modules/@j2inn/react-config/webpack.config.js",
		"analyze:prod": "webpack --config ./webpack.production.config.js --stats --json > stats.json && webpack-bundle-analyzer stats.json build/"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@j2inn/react-config": "^5.0.0",
		"@pmmmwh/react-refresh-webpack-plugin": "^0.5.10",
